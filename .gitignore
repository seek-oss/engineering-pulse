# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
.env/

# Environment and secrets (python-dotenv)
.env
.env.*
!.env.example

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# Type checkers / linters (if added later)
.mypy_cache/
.ruff_cache/

# Packaging
build/
dist/
*.egg-info/
*.egg

# macOS
.DS_Store

# Editor swap files
.idea/
.vscode/
*.swp
*.swo
*~

# Customer-specific dashboard definitions (contain real Datadog URLs — local only).
# Underscore-prefixed files are reference templates and stay in the repo.
prompts/dashboards/*.md
!prompts/dashboards/_*.md

# Drop-in extras plugin folder (user content — local only)
prompts/extras/*.md
!prompts/extras/_example.md

# Stakeholder pulse cards (regenerated on every run by the agent)
prompts/stakeholders/*.md
!prompts/stakeholders/_example.md

# Local maintainer tools (org-term scanner, etc. — not shipped)
local/

# Generated output (regenerated on every run)
output/
*.html
*.txt
github_prs.json
dashboard*.json
