# ── Agent CLI ───────────────────────────────────────────────────────────────
# Which AI agent CLI runs scheduled dashboard prompts (set by installer's selector).
#   claude — Claude Code CLI (https://docs.anthropic.com/en/docs/claude-code)
#   cursor — Cursor Agent CLI (https://cursor.com/cli)
#   pi     — Pi Agent (https://pi.dev) **[in progress]** — see harness/pi-agent/README.md
AGENT_CLI=claude

# Required for Claude Code in automation mode (subscription cannot be used for scheduled tasks)
# ANTHROPIC_API_KEY=sk-ant-...

# Required only if experimenting with Pi + AGENT_CLI=pi (support in progress)
# PI_API_KEY=sk-...

# Cursor CLI uses your Cursor account — no API key needed here.

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token with `repo` (read) + `read:org` scopes
GITHUB_TOKEN=your_github_pat
GITHUB_ORG=your-org-slug          # e.g. my-company
GITHUB_TEAM=your-team-slug        # e.g. platform-engineering

# ── Datadog ───────────────────────────────────────────────────────────────────
# Daily dashboard uses Datadog MCP (OAuth in Cursor / Claude Code) — no keys required.

# Comma-separated team slugs — filters both the dashboard URL and metric queries
# Single:   team-a
# Multiple: team-a,team-b
DATADOG_TEAMS=your-team-slug

# ── Delivery (how you get each report) ────────────────────────────────────────
# Every report is ALWAYS saved locally, whatever you choose below:
#   output/reports/YYYY/MM/DD/<type>-HHMMSS.html   one file per run, never overwritten
#   output/reports/index.html                      calendar of all reports
#   output/reports/latest.html                     the newest report
# Open the calendar with `make reports` (or double-click index.html). Click a day
# to step through that day's reports with ← / →; grey days have no reports.
#
# DELIVERY picks what happens AFTER the report is saved:
#   notify — macOS notification; click it to open the report (default)
#   email  — send by SMTP (fill in the Email section below)
#   both   — notification and email
#   none   — local file only: no notification, no email
#
# Examples:
#   DELIVERY=none     # just keep the files; open the calendar when you want
#   DELIVERY=notify   # get a banner on your Mac when a report is ready
#   DELIVERY=both     # banner + email (e.g. while moving away from email)
#
# Clickable notifications use terminal-notifier, which install.sh installs via
# Homebrew. Without it you get a plain banner that does not open the report.
# Notifications only appear while you're logged in and the Mac is awake.
DELIVERY=notify

# Optional:
# REPORT_AUTO_OPEN=1          # also open the report in your browser after each run
# REPORT_RETENTION_DAYS=90    # days of reports to keep (default 90; 0 = keep forever)
# REPORTS_DIR=~/engineering-pulse-reports  # save somewhere else (default: output/reports)
#
# Run times are not set here — they live in the macOS LaunchAgent. To change them:
#   .venv/bin/python scripts/schedule.py show
#   .venv/bin/python scripts/schedule.py set --days mon-sun --times 10:00

# ── Email (Gmail SMTP — only for DELIVERY=email or both; skip for notify/none) ─
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST and SMTP_PORT default to smtp.gmail.com:587 — omit to use defaults
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx   # 16-char App Password (spaces are fine)
SMTP_FROM=you@gmail.com
SMTP_TO=recipient@example.com

# ── Todoist (work tasks, personal tasks, reading queue) ───────────────────────
# Get your token: Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=your_todoist_api_token

# ── Stakeholder Pulse (optional) ─────────────────────────────────────────────
# Comma-separated full names or emails; empty/unset skips Step 2F and the HTML section
# Slack data today: Glean MCP in Cursor. Read-only Slack token: not implemented yet.
STAKEHOLDERS=Jane Doe,john.smith@xyz.com.au

# ── Sprint Burndown (optional) ────────────────────────────────────────────────
# Consumed by the sprint-report skill. One free-form sentence describing
# your sprint board. The agent parses the URL (host, project key, board id),
# discovers cloudId and custom-field ids at runtime, and picks the active sprint.
# If unset, the skill asks you to paste the same sentence into chat instead.
#
# Optional extras you can append to the sentence (only if they apply):
#   • "use story points"                                    — override unit (default: ticket count)
#   • "team is 2 SYD + 2 LON + 1 SF; exclude public holidays in Sydney, London, San Francisco" — per-location holiday adjustment
SPRINT_BOARD="My sprint board is at https://<tenant>.atlassian.net/jira/software/c/projects/<PROJ>/boards/<id>. Only include epics whose summary starts with [TEAM-PREFIX]. Sprints run for two weeks; use the moment Jira activated the current sprint as the report's baseline start."