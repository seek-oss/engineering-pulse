# Engineering Pulse settings. Lines starting with # are optional.
# Run times, paused reports and how long to keep reports are set in the
# calendar's Settings panel (make reports, then Settings), not here.
# Full reference: skills/engineering-pulse/references/env-and-paths.md

# Agent that runs the reports: claude | cursor | pi (set by install.sh)
AGENT_CLI=claude

# Datadog team slug(s), comma-separated. Data comes from Datadog MCP.
DATADOG_TEAMS=your-team

# GitHub team whose PR reviews you track, as org/team. Data comes from GitHub MCP.
GITHUB_TEAM=your-org/your-team

# Stakeholder Pulse: names or emails, comma-separated. Data comes from Glean MCP.
# STAKEHOLDERS=Jane Doe,jane@example.com

# Sprint report: describe your board in one sentence. Data comes from Atlassian MCP.
# You can add "use story points" or team locations for public holidays to the sentence.
# SPRINT_BOARD="My sprint board is at https://<tenant>.atlassian.net/jira/software/c/projects/<PROJ>/boards/<id>. Only include epics whose summary starts with [TEAM]. Sprints run for two weeks."

# Todoist tasks for the My Queue section (Todoist > Settings > Integrations > Developer).
# TODOIST_API_TOKEN=

# How you hear about a new report: notify | email | both | none
DELIVERY=notify

# Email, only for DELIVERY=email or both. Use a Gmail App Password.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_TO=you@example.com
